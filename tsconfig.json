{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@bag-it/callout-parts": [
        "./packages/callout-parts/src/index.ts"
      ],
      "@bag-it/part-colors": [
        "./packages/part-colors/src/index.ts"
      ],
      "@bag-it/part-matching": [
        "./packages/part-matching/src/index.ts"
      ],
      "@bag-it/raster-quantity-labels": [
        "./packages/raster-quantity-labels/src/index.ts"
      ],
      "@bag-it/step-callouts": [
        "./packages/step-callouts/src/index.ts"
      ],
      "@bag-it/test-support": [
        "./packages/test-support/src/index.ts"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    ".bag-it",
    ".npm-cache",
    ".pnpm-store",
    "node_modules"
  ]
}
