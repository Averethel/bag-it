{
  "name": "bag-it",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:vercel": "npm run catalogue:download && npm run build",
    "postinstall": "npm run typegen",
    "typegen": "chakra typegen ./src/components/ui/theme.ts --strict --clean --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typegen && npm run typecheck && npm run lint && npm run test && npm run build",
    "analyze:examples": "node scripts/analyze-local-examples.mjs",
    "validate:manuals": "node scripts/validate-manual-parts.mjs --suite --output .bag-it/private/validation/latest.json",
    "catalogue:download": "node scripts/download-rebrickable-catalogue.mjs"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "dependencies": {
    "@chakra-ui/react": "3.35.0",
    "@emotion/react": "11.14.0",
    "@paddleocr/paddleocr-js": "0.3.2",
    "lucide-react": "1.14.0",
    "next": "16.2.6",
    "pdfjs-dist": "5.7.284",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@chakra-ui/cli": "3.35.0",
    "@eslint/eslintrc": "3.3.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "25.6.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "29.1.1",
    "playwright": "1.59.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
