{
  "name": "bag-it-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --webpack",
    "start": "next start",
    "build": "next build --webpack",
    "postinstall": "chakra typegen ./src/components/ui/theme.ts --strict --clean --tsconfig ./tsconfig.json",
    "typegen": "chakra typegen ./src/components/ui/theme.ts --strict --clean --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:steps-fixtures": "vitest run src/features/steps/fixtures/step-fixture-gate.test.ts",
    "test:e2e": "next build --webpack && npm run validate:e2e-fixtures",
    "test:e2e:deployed": "PLAYWRIGHT_BASE_URL=${PLAYWRIGHT_BASE_URL:-${WEBWRIGHT_BASE_URL:-http://127.0.0.1:3000}} playwright test tests/e2e/bag-analysis.spec.ts --project=chrome",
    "benchmark:steps": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/benchmark-step-scan.mjs",
    "fixtures:steps": "node scripts/generate-step-fixtures.mjs",
    "report:part-colors": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/write-part-color-report.mjs",
    "report:part-matches": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/write-part-match-report.mjs",
    "report:part-color-training": "node scripts/part-color-training-dataset.mjs",
    "freeze:part-match-labels": "node scripts/part-match-freeze-labels.mjs",
    "report:e2e-fixture-diffs": "next build --webpack && playwright test tests/e2e/bag-analysis-report.spec.ts --project=chrome --reporter=line",
    "evaluate:part-color-runtime": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/evaluate-part-color-runtime.mjs",
    "evaluate:part-match-labels": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-label-eval.mjs",
    "analyze:part-match-rules": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-rule-analysis.mjs",
    "analyze:part-match-holdout": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-holdout-analysis.mjs",
    "report:part-match-review-queue": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/write-part-match-review-queue.mjs",
    "lab:part-match-verifier": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-verifier-lab.ts",
    "lab:part-match-embeddings": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-embedding-cache.ts",
    "lab:part-match-embedding-score": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-embedding-score.ts",
    "lab:part-match-pair-lanes": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-pair-lane-analysis.ts",
    "lab:part-match-lane-review": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-lane-review.ts",
    "lab:part-match-hybrid-score": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-hybrid-score.ts",
    "lab:part-match-feature-fusion-score": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-feature-fusion-score.ts",
    "lab:part-match-export-feature-fusion-scorer": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-export-feature-fusion-scorer.ts",
    "lab:part-match-runtime-score": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-runtime-score.ts",
    "lab:part-match-runtime-group-score": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-runtime-group-score.ts",
    "lab:part-match-attribute-spike": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-attribute-spike.ts",
    "lab:part-match-lego-training-data": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-lego-training-data.ts",
    "lab:part-match-manual-training-data": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-manual-training-data.ts",
    "lab:part-match-lego-training-embeddings": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-lego-training-embedding-cache.ts",
    "lab:part-match-lego-cnn": "node scripts/train-part-match-lego-cnn.mjs",
    "lab:part-match-catalogue-retrieval": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-catalogue-retrieval.ts",
    "lab:part-match-catalogue-poc": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-catalogue-poc.ts",
    "lab:part-match-ldraw-render": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-ldraw-render.ts",
    "lab:part-match-ldraw-three-render": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/part-match-ldraw-three-render.ts",
    "train:part-match-lego-reranker": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/train-part-match-lego-reranker.ts",
    "train:part-match-scorer": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/train-part-match-scorer.ts",
    "update:part-color-prototypes": "node --no-warnings --loader ./scripts/ts-extension-loader.mjs scripts/update-part-color-prototypes.mjs --manual-ids 01-castle-ramp,02-middle-wall,04-bakery",
    "update:rebrickable-colors": "node scripts/update-rebrickable-color-catalog.mjs",
    "validate:detector-regressions": "node scripts/validate-detector-regressions.mjs",
    "validate:detector-tuning": "node scripts/validate-detector-regressions.mjs --strict",
    "validate:e2e-fixtures": "playwright test tests/e2e/bag-analysis.spec.ts --project=chrome",
    "validate:saved-sessions:browser": "npm run test:e2e",
    "webwright:validate": "npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "verify": "chakra typegen ./src/components/ui/theme.ts --strict --clean --tsconfig ./tsconfig.json && tsc --noEmit && eslint . && vitest run && npm run validate:detector-regressions"
  },
  "dependencies": {
    "@bag-it/callout-parts": "workspace:*",
    "@bag-it/part-colors": "workspace:*",
    "@bag-it/part-matching": "workspace:*",
    "@bag-it/raster-quantity-labels": "workspace:*",
    "@bag-it/step-callouts": "workspace:*",
    "@chakra-ui/react": "^3.35.0",
    "@emotion/react": "^11.14.0",
    "lucide-react": "^0.469.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.4",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.35.0",
    "@huggingface/transformers": "^4.2.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-sonarjs": "4.0.3",
    "jsdom": "^25.0.1",
    "three": "^0.184.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
