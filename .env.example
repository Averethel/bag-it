# Directory containing the local catalogue CSV snapshot used by /api/catalogue/*.
# Local development defaults to .bag-it/private/catalogue when this is unset.
BAG_IT_CATALOGUE_DIR=.bag-it/private/catalogue

# Server-side key used only by catalogue refresh/on-demand cache creation.
# Required to generate external_color_aliases.csv from Rebrickable colors.
REBRICKABLE_API_KEY=
