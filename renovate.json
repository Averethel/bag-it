{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":automergePatch",
    ":automergePr",
    ":automergeRequireAllStatusChecks"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.circleci\\/config\\.yml$/"],
      "matchStrings": [
        "vercel_cli_version:\\n\\s+type: string\\n\\s+default: \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "vercel",
      "datasourceTemplate": "npm"
    }
  ],
  "labels": ["dependencies"],
  "skipInstalls": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Automerge non-major development dependency updates after checks pass.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Group workspace packages together.",
      "groupName": "bag-it workspace packages",
      "matchPackageNames": ["/^@bag-it\\//"]
    },
    {
      "description": "Group the framework runtime together.",
      "groupName": "next and react",
      "matchPackageNames": [
        "next",
        "eslint-config-next",
        "react",
        "react-dom",
        "next-themes"
      ]
    },
    {
      "description": "Group Chakra UI packages together.",
      "groupName": "chakra ui",
      "matchPackageNames": ["@chakra-ui/react", "@chakra-ui/cli", "@emotion/react"]
    },
    {
      "description": "Group manual analysis runtime packages together.",
      "groupName": "manual analysis runtime",
      "matchPackageNames": [
        "@huggingface/transformers",
        "onnxruntime-web",
        "pdfjs-dist",
        "three"
      ]
    },
    {
      "description": "Group unit and browser test tooling together.",
      "groupName": "test tooling",
      "matchPackageNames": [
        "@playwright/test",
        "@testing-library/**",
        "jsdom",
        "vitest"
      ]
    },
    {
      "description": "Group CI runtime images together.",
      "groupName": "ci runtime images",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["cimg/node", "mcr.microsoft.com/playwright"]
    }
  ]
}
